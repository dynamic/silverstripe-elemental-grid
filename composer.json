{
    "name": "wedevelopnl/silverstripe-elemental-grid",
    "description": "Elemental grid module",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "element",
        "elemental",
        "content blocks",
        "grid"
    ],
    "authors": [{
        "name": "WeDevelop",
        "email": "development@wedevelop.nl"
    }],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "silverstripe/admin": "^3.0",
        "silverstripe/framework": "^6.0",
        "silverstripe/vendor-plugin": "^3.0",
        "dnadesign/silverstripe-elemental": "^6.0",
        "wedevelopnl/silverstripe-media-field": "dev-feature/ss6-upgrade",
        "jonom/focuspoint": "^6.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.4"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/dynamic/silverstripe-media-field.git"
        }
    ],
    "extra": {
        "expose": [
            "client/dist",
            "client/images"
        ]
    },
    "autoload": {
        "psr-4": {
            "WeDevelop\\ElementalGrid\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": false,
            "silverstripe/vendor-plugin": false
        }
    }
}
